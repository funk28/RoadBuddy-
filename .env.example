# Backend (Flask). Copy to backend/.env and fill in; never commit .env.

# PostGIS connection (docker compose in backend/ exposes it on 5433).
DATABASE_URL=postgresql+psycopg://roadbuddy:roadbuddy@localhost:5433/roadbuddy
# Database pytest uses; it is wiped between tests.
TEST_DATABASE_URL=postgresql+psycopg://roadbuddy:roadbuddy@localhost:5433/roadbuddy_test

# OAuth client ID(s) the Android app's Google ID tokens are issued for (comma-separated).
GOOGLE_CLIENT_IDS=

# Local development only: accept "Authorization: Bearer dev:<any-user-id>" instead of
# a real Google ID token. Must stay false on EC2.
DEV_AUTH=false

# Where uploaded detection frames are stored.
IMAGE_STORAGE_DIR=./var/images

# Hazard classifier: "stub" until the VLM adapter (#49) lands.
VLM_CLASSIFIER=stub
VLM_TIMEOUT_S=5

# Detections within this many meters of a live hazard are merged into it.
HAZARD_MATCH_RADIUS_M=15
